{
  "manifestVersion": "1.0.0",
  "providerId": "io.github.uskyu.dsh-usage-stats",
  "name": "DSH Usage Stats",
  "description": "Token usage analytics for the dsh web GUI: per-model daily trend, month share donut, calendar heatmap, costs, and exports. 标准来源接入（Path A），便于在 DSH 插件市场内通过 GUI 直接安装。",
  "homepage": "https://github.com/uskyu/dsh-usage-stats",
  "attribution": {
    "name": "uskyu",
    "url": "https://github.com/uskyu"
  },
  "transport": {
    "kind": "https-json",
    "endpoint": "https://uskyu.github.io/dsh-usage-stats/v1/plugins",
    "method": "GET"
  },
  "query": {
    "supported": [
      "q",
      "category",
      "cursor",
      "limit"
    ],
    "defaultLimit": 50,
    "maxLimit": 50,
    "sorts": []
  }
}
